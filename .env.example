# Server Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Angular SSR SSRF Protection (REQUIRED in Coolify)
# Set to a comma-separated list of your public domain(s)
NG_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Reverse Proxy Headers (Traefik / Caddy in Coolify)
NG_TRUST_PROXY_HEADERS=x-forwarded-host,x-forwarded-proto,x-forwarded-for
